# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-your-token

# Key used to encrypt the stored data (user passwords + JWTs).
# REQUIRED: use a long random string, e.g. openssl rand -hex 32
BOT_SECRET=replace-with-a-random-32-byte-hex-string

# --- Runtime ------------------------------------------------------------
# webhook = Deno Deploy (HTTP endpoint + Deno.cron). Polling = local machine
# (grammY long polling + Discord gateway + an interval scheduler).
# Defaults to "webhook" on Deno Deploy (DENO_DEPLOY=true) and "polling" locally.
RUNTIME_MODE=

# Public origin of the deployed app, no trailing slash — used for the
# Telegram webhook URL. Required in webhook mode, e.g.
# https://my-app.deno.dev
PUBLIC_URL=

# Guards Telegram's X-Telegram-Bot-Api-Secret-Token. Defaults to BOT_SECRET.
WEBHOOK_SECRET=

# Port for the webhook HTTP server (Deno Deploy sets its own via the platform).
PORT=8000

# One-shot: the exact contents of an old data/store.json, pasted here to seed an
# empty store (neither serverless host has a file to migrate from). The payload
# stays sealed with BOT_SECRET. Delete it once the bot shows your accounts.
STORE_IMPORT=

# Auto check-in time (Vietnam time, default 00:00 = midnight)
CHECKIN_HOUR=0
CHECKIN_MINUTE=0

# Start the attempt this many seconds BEFORE the scheduled time.
# The fastest check-in of the day earns a bigger reward, so the bot wakes up
# early and keeps knocking: if the server has not rolled over to the new day
# yet, it retries (see CHECKIN_MAX_WAIT_SECONDS) instead of giving up.
CHECKIN_EARLY_SECONDS=5

# How long after the scheduled time the bot keeps retrying while the server
# still counts the previous day (covers a slow/inaccurate server clock).
CHECKIN_MAX_WAIT_SECONDS=600

# PBKDF2 rounds for sealing the store. A Cloudflare Worker's free plan allows
# 10ms of CPU per invocation, which a 150k-round key derivation exceeds; the
# round count travels inside the sealed record, so an old one still opens.
KDF_ITERATIONS=1000

# Guards the /race route the nightly check-in is triggered over. The scheduler is
# cron-job.com (see README), which sends no custom headers, so the same secret is
# accepted as ?key=, as a bearer token, or as basic-auth password.
WORKER_SECRET=

# Where to store the data. Locally this holds the Deno KV file (store.kv);
# on Deno Deploy the platform's KV instance is used instead.
# Guards the /race route a Cloudflare Worker's cron handler calls on itself
# (it is the only way the midnight check-in runs where Smart Placement puts it).
# Defaults to BOT_SECRET when unset.
WORKER_SECRET=

# Where to store the data. Locally this holds the Deno KV file (store.kv);
DATA_DIR=data
